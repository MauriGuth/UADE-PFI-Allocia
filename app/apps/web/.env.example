# URL base del backend de Allocia (la misma API que consume la app móvil).
# Solo se usa del lado del servidor de Next.js: el navegador nunca la ve ni
# recibe el JWT (la sesión viaja en una cookie httpOnly).
API_URL=http://localhost:4000
WEB_ORIGIN=http://localhost:3000
# Same server-only secret as API, to authenticate client IP forwarding on Vercel/Railway.
BFF_SIGNING_SECRET=
# Activar durante la migración antes de habilitar el acceso público.
APP_MAINTENANCE=false

# Lista explícita para dominio propio y URL alternativa; sin comodines.
WEB_ORIGINS=http://localhost:3000
