NODE_ENV=production
HOST=0.0.0.0
PORT=4000

# Base PostgreSQL con TLS validable. DB_CA_PEM puede contener la CA del proveedor.
DATABASE_URL=postgresql://user:password@host:5432/allocia
DB_CA_PEM=
# Optional certificate name, only with a pinned CA (legacy Railway cert: localhost).
DB_TLS_SERVERNAME=
REDIS_URL=rediss://user:password@host:6379

# Generar ambos secretos con un gestor criptográfico. No versionar sus valores reales.
JWT_SECRET=
HOLDINGS_ENCRYPTION_KEY=
WEB_ORIGINS=https://app.example.com
TRUSTED_PROXY_CIDR=
TRUST_RAILWAY_EDGE=false
BFF_SIGNING_SECRET=

# Proveedores server-side. ANTHROPIC_MODEL debe ser un ID habilitado en la cuenta.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
# true = señales y noticias en vivo (con traducción) también en desarrollo local.
LIVE_SIGNALS=
FINNHUB_API_KEY=
COINGECKO_API_KEY=

# Archivos montados y mantenidos por el operador.
MARKET_UNIVERSE_FILE=/run/config/market-universe.json
MARKET_CALENDAR_FILE=/run/config/market-calendar.json
AI_MAX_REPORTS_PER_DAY=100

# Push Expo. Mantener desactivado hasta configurar APNs/FCM y probar receipts.
PUSH_ENABLED=false
EXPO_ACCESS_TOKEN=

# Correos transaccionales: remitente de un dominio propio verificado en Resend.
# API y worker necesitan estos mismos valores. No usar la dirección @uade.edu.ar
# como remitente sin controlar y verificar su DNS.
RESEND_API_KEY=
MAIL_FROM=
PUBLIC_WEB_URL=https://app.example.com
